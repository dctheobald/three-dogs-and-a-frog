digraph arch {
  rankdir=LR; bgcolor="#fbfaf3"; fontname="Helvetica"; nodesep=0.5; ranksep=0.9;
  labelloc="t"; label=<<FONT POINT-SIZE="26"><B>3 Dogs &amp; a Frog &#8212; Edge-Native AgentOps Architecture</B></FONT>>;
  node [fontname="Helvetica"]; edge [fontname="Helvetica", fontsize=11, color="#555555", fontcolor="#333333"];

  user [shape=box, style="rounded,filled", fillcolor="#f0efe9", color="#8a8a80", fontsize=13, label="User Browser\n&\nAI Agents"];

  fastly [shape=none, margin=0, label=<
  <TABLE BORDER="2" CELLBORDER="0" CELLSPACING="6" CELLPADDING="9" BGCOLOR="#fdeceb" COLOR="#e34948">
    <TR><TD><B><FONT COLOR="#c0392b" POINT-SIZE="16">FASTLY EDGE &#8212; Intelligence &amp; Control Plane</FONT></B></TD></TR>
    <TR><TD BGCOLOR="#f0efe9"><FONT POINT-SIZE="12">CDN &#183; redirects &#183; TLS &#183; static cache (24h)</FONT></TD></TR>
    <TR><TD BGCOLOR="#e6f0ff"><FONT POINT-SIZE="12"><B>IDENTIFY</B> &#183; Bot Management + ContentGuard<BR/>human / verified-agent / bot</FONT></TD></TR>
    <TR><TD BGCOLOR="#ffece0"><FONT POINT-SIZE="12"><B>GOVERN</B> &#183; Edge Rate Limiting (100 rps)<BR/>agent governance on /api/agent (shadow &#8596; enforce)</FONT></TD></TR>
    <TR><TD BGCOLOR="#f4fbdd"><FONT POINT-SIZE="12"><B>MONETIZE</B> &#183; edge-served catalog /catalog<BR/>agent gate on /catalog &#183; /mcp</FONT></TD></TR>
  </TABLE>>];

  gcp [shape=none, margin=0, label=<
  <TABLE BORDER="2" CELLBORDER="0" CELLSPACING="6" CELLPADDING="9" BGCOLOR="#e8f0fe" COLOR="#4285F4">
    <TR><TD><B><FONT COLOR="#1a56c4" POINT-SIZE="16">GCP COMPUTE ENGINE</FONT></B><BR/><FONT POINT-SIZE="10">e2-micro &#183; Docker network frog-net</FONT></TD></TR>
    <TR><TD BGCOLOR="white"><FONT POINT-SIZE="12"><B>Caddy</B> &#183; TLS sidecar (:443, self-signed)</FONT></TD></TR>
    <TR><TD BGCOLOR="white"><FONT POINT-SIZE="12"><B>Node.js Retail App</B> (:3000)<BR/>Wise Frog &#183; Gemini 3.6 (Vertex, global)<BR/>MCP server /mcp &#183; Stripe checkout<BR/>single source: data/products.json</FONT></TD></TR>
  </TABLE>>];

  stripe [shape=box, style="rounded,filled", fillcolor="#eeecff", color="#635bff", fontcolor="#4b45c6", fontsize=13, label="Stripe\nCheckout"];
  bq [shape=none, margin=0, label=<
  <TABLE BORDER="2" CELLBORDER="0" CELLSPACING="6" CELLPADDING="8" BGCOLOR="#eaf1fd" COLOR="#669df6">
    <TR><TD><B><FONT COLOR="#1a56c4" POINT-SIZE="13">BigQuery &#183; agentops</FONT></B></TD></TR>
    <TR><TD BGCOLOR="white"><FONT POINT-SIZE="11">edge_requests &#183; traffic &amp; governance</FONT></TD></TR>
    <TR><TD BGCOLOR="white"><FONT POINT-SIZE="11">agent_commerce &#183; checkouts &amp; revenue</FONT></TD></TR>
  </TABLE>>];
  looker [shape=box, style="rounded,filled", fillcolor="#e9f7ee", color="#34a853", fontsize=11, label="Looker Studio\nEdge Traffic dashboard\n(Identify / Govern / Monetize)"];
  secret [shape=box, style="rounded,filled", fillcolor="#fff8e1", color="#f9a825", fontsize=10, label="Secret Manager\nStripe & Gemini keys"];
  registry [shape=box, style="rounded,filled", fillcolor="#f0efe9", color="#b4b2a9", fontsize=10, label="Artifact Registry\ncontainer images"];

  user -> fastly [label="HTTPS", penwidth=2];
  fastly -> gcp [label="HTTPS 443\n(cache miss)", penwidth=2];
  gcp -> stripe [label="checkout"];
  fastly -> bq [label="real-time logs", style=dashed, color="#669df6", fontcolor="#3b78c4"];
  bq -> looker [color="#34a853"];
  secret -> gcp [label="inject", style=dashed];
  registry -> gcp [label="pull on boot", style=dashed];
}
